{
  "name": "ymirtool-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "node scripts/run-python.mjs scripts/cleanup-unused-assets.py",
    "test:fast": "node --test tests/ymir-fast-core.test.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:cache": "node scripts/seo-check.mjs --write-cache",
    "remediate": "node scripts/run-python.mjs scripts/phase8-fast-core-layout.py",
    "validate": "node scripts/phase8-validate.mjs",
    "audit": "node scripts/run-python.mjs scripts/phase7-audit.py --output .seo-cache/final-audit.json",
    "smoke": "node scripts/run-python.mjs scripts/phase7-http-smoke.py",
    "test": "npm run seo:check && npm run test:fast && npm run validate && npm run audit && npm run smoke"
  }
}
